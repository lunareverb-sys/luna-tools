#!/usr/bin/env python3
"""ficha <domínio|IP> — ficha pública para triagem (phishing, IoC de aviso de segurança).
Só domínio/IP: nada de pessoas, câmeras ou varredura de portas.
PRIVACIDADE: o domínio/IP consultado é ENVIADO a terceiros (rdap.org, cloudflare-dns.com, crt.sh).
Não consulte nada que não possa ser revelado a eles. Use só para triagem legítima.
Fontes abertas, sem chave: RDAP (rdap.org), DNS por HTTPS (Cloudflare), certificados (crt.sh).
Só consulta: não acessa o site nem faz varredura. Cada linha diz a fonte."""
import ipaddress, json, sys, urllib.parse, urllib.request
from datetime import datetime, timezone

UA = {"User-Agent": "luna-ficha/1.0", "Accept": "application/json, application/dns-json"}


def get(url, timeout=12):
    h = {"User-Agent": UA["User-Agent"],
         "Accept": "application/dns-json" if "dns-query" in url else "application/json"}
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers=h), timeout=timeout) as r:
            return json.loads(r.read(3_000_000).decode("utf-8", "replace"))
    except Exception as e:  # noqa: BLE001
        return {"_erro": f"{type(e).__name__}"}


def evento(rd, acao):
    for e in rd.get("events", []) or []:
        if e.get("eventAction") == acao:
            return e.get("eventDate", "")[:10]
    return ""


def dias(data):
    try:
        return (datetime.now(timezone.utc) - datetime.fromisoformat(data[:10]).replace(tzinfo=timezone.utc)).days
    except ValueError:
        return None


alvo = sys.argv[1].strip().lower().removeprefix("http://").removeprefix("https://").split("/")[0] if len(sys.argv) > 1 else ""
if not alvo:
    print("uso: ficha <domínio|IP>"); sys.exit(2)
try:
    ip = ipaddress.ip_address(alvo)
except ValueError:
    ip = None
print(f"# Ficha: {alvo}  ({datetime.now():%d/%m/%Y %H:%M})")
alertas = []
if ip and (ip.is_private or ip.is_loopback or ip.is_link_local):
    # endereço interno nunca sai da máquina
    print("- IP privado/local: nenhuma consulta externa feita")
    alertas.append("IP privado (rede interna)")
elif ip:
    rd = get(f"https://rdap.org/ip/{alvo}")
    print(f"- RDAP (rdap.org): rede {rd.get('name', '?')} · {rd.get('startAddress', '')}–{rd.get('endAddress', '')} · país {rd.get('country', '?')}")
    for ent in (rd.get("entities") or [])[:3]:
        v = ent.get("vcardArray", [None, []])[1]
        nome = next((x[3] for x in v if x and x[0] == "fn"), "")
        print(f"  - {', '.join(ent.get('roles', []))}: {nome}")
else:
    rd = get(f"https://rdap.org/domain/{alvo}")
    criado, venc = evento(rd, "registration"), evento(rd, "expiration")
    reg = ""
    for e in rd.get("entities") or []:
        if "registrar" in (e.get("roles") or []):
            reg = next((x[3] for x in (e.get("vcardArray") or [None, []])[1] if x and x[0] == "fn"), "")
            break
    idade = dias(criado) if criado else None
    print(f"- RDAP (rdap.org): criado {criado or '?'}" + (f" ({idade} dias)" if idade is not None else "")
          + f" · vence {venc or '?'} · registrador {reg or '?'} · status {', '.join(rd.get('status', []) or ['?'])}")
    if idade is not None and idade < 30:
        alertas.append(f"domínio NOVO ({idade} dias) — comum em phishing")
    if "_erro" in rd:
        alertas.append(f"RDAP não respondeu ({rd['_erro']})")
    for tipo in ("A", "AAAA", "MX", "NS", "TXT"):
        d = get(f"https://cloudflare-dns.com/dns-query?name={urllib.parse.quote(alvo)}&type={tipo}")
        resp = [a.get("data", "") for a in d.get("Answer", []) or []]
        if resp:
            print(f"- DNS {tipo} (Cloudflare DoH): " + "; ".join(r[:90] for r in resp[:4]))
        if tipo == "TXT":
            txt = " ".join(resp).lower()
            if "v=spf1" not in txt:
                alertas.append("sem SPF")
    dm = get(f"https://cloudflare-dns.com/dns-query?name=_dmarc.{urllib.parse.quote(alvo)}&type=TXT")
    if not any("v=dmarc1" in a.get("data", "").lower() for a in dm.get("Answer", []) or []):
        alertas.append("sem DMARC")
    ct = get(f"https://crt.sh/?q={urllib.parse.quote(alvo)}&output=json", timeout=25)
    if isinstance(ct, list):
        datas = sorted({c.get("not_before", "")[:10] for c in ct if c.get("not_before")})
        nomes = sorted({n for c in ct for n in str(c.get("name_value", "")).split("\n")})[:8]
        print(f"- Certificados (crt.sh): {len(ct)} · primeiro {datas[0] if datas else '?'} · último {datas[-1] if datas else '?'}")
        print(f"  - nomes: {', '.join(nomes)}")
    else:
        print(f"- Certificados (crt.sh): não respondeu ({ct.get('_erro', '?')})")
print("- Alertas: " + ("; ".join(alertas) if alertas else "nenhum dos sinais simples"))
print("_Só dados públicos; não abri o site. Sinal ≠ prova: confira antes de afirmar._")
